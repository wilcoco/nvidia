{
  "name": "flowcatch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:sdk": "esbuild sdk/index.ts --bundle --format=iife --outfile=public/flowcatch.js",
    "dev": "npm run build:sdk && vite",
    "dev:server": "node server/index.js",
    "build": "npm run build:sdk && vite build",
    "check": "tsc --noEmit",
    "start": "node server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^4.21.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
