{
  "name": "understudy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:sdk": "esbuild sdk/index.ts --bundle --format=iife --outfile=public/understudy.js",
    "dev": "npm run build:sdk && vite",
    "dev:server": "node server/index.js",
    "build": "npm run build:sdk && vite build",
    "check": "tsc --noEmit",
    "start": "node server/index.js",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "npm run build && node --test tests/browser-e2e.mjs",
    "test:postgres": "node scripts/require-test-database.mjs && node --test tests/*.test.mjs",
    "release:manifest": "node scripts/release-manifest.mjs"
  },
  "dependencies": {
    "express": "^4.21.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "playwright-core": "1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
